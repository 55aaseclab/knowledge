# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee

# Build this application from its own repository context.
FROM ${NODE_IMAGE} AS base
ARG PRAXIS_UID=1000
ARG PRAXIS_GID=1000
WORKDIR /app
ENV NODE_ENV=production HOST=127.0.0.1
RUN groupmod -o -g "${PRAXIS_GID}" node && usermod -o -u "${PRAXIS_UID}" node \
    && mkdir -p /app /data /data/home && chown -R node:node /app /data /home/node
USER node

FROM base AS knowledge
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-xlrd python3-openpyxl poppler-utils antiword catdoc unrtf ca-certificates \
    && rm -rf /var/lib/apt/lists/*
USER node
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node src/ ./src/
COPY --chown=node:node scripts/ ./scripts/
COPY --chown=node:node praxis-provider.mjs ./
ENV PORT=14324 KNOWLEDGE_DATA_DIR=/data
EXPOSE 14324
CMD ["node", "src/runtime/server.mjs"]
